{
  "name": "@dsh-mywork/adapter-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapter SDK: stable port catalog, capability negotiation and registry, contract revisions, conformance kit, and deterministic fakes",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@dsh-mywork/contracts": "workspace:*"
  }
}
