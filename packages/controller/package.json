{
  "name": "@dsh-mywork/controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MyWork controller plugin for DSH: mounts the control-plane service into a profile",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@dsh-mywork/adapter-sdk": "workspace:*",
    "@dsh-mywork/contracts": "workspace:*",
    "@dsh-mywork/core": "workspace:*",
    "@dsh-mywork/evidence": "workspace:*",
    "@dsh-mywork/execution": "workspace:*",
    "@dsh-mywork/lease": "workspace:*",
    "@dsh-mywork/planner": "workspace:*",
    "@dsh-mywork/scheduler": "workspace:*",
    "@dsh-mywork/storage": "workspace:*"
  }
}
