{
  "name": "dsh-mywork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MyWork — a DSH plugin for sustained multi-agent work (v0.1 foundation)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/run-tests.mjs \"tests/**/*.test.mjs\"",
    "check": "pnpm run typecheck && pnpm run build && pnpm run smoke && pnpm run test && pnpm run check:plan",
    "check:plan": "node scripts/check-plan-citations.mjs",
    "pack:local": "pnpm run build && node scripts/pack.mjs",
    "verify:profile": "pnpm run build && node scripts/verify-profile.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  }
}
